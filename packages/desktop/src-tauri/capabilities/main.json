{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allow only the installed main UI to use desktop commands.",
  "webviews": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:13433"]
  },
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-open-website-review",
    "allow-position-website-review",
    "allow-set-website-review-visible",
    "allow-set-website-review-tool",
    "allow-close-website-review",
    "allow-import-browser-bookmarks"
  ]
}
